# Image version from https://github.com/sharqey/self-hosted/pkgs/container/server
SHARQEY_VERSION=0.8.0

# Public HTTPS address of your instance (your reverse proxy).
BASE_URL=https://sharqey.example.com

# Generate both with: openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional SSO license
SHARQEY_LICENSE=
